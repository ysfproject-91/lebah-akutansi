{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BukuKas",
  "version": "1.0.0",
  "identifier": "id.bukukas.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "BukuKas", "width": 420, "height": 860 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
